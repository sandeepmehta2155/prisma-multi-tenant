{
  "version": "3.1.0",
  "private": true,
  "scripts": {
    "bootstrap": "npm run _tmp_preinstall && npm i && npm run build && npm run link:cli",
    "link:cli": "cd packages/cli && npm uninstall -g prisma-multi-tenant && npm link",
    "check": "node scripts/check.js",
    "publish": "node scripts/publish.js",
    "test": "npm run test:cli && npm run test:client",
    "test:cli": "jest tests/cli/",
    "test:client": "bash tests/playground/test-client.sh",
    "_tmp_preinstall": "mkdir -p packages/cli/build && touch packages/cli/build/index.js",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/node-fetch": "^2.5.7",
    "dotenv-cli": "^3.2.0",
    "inquirer": "^8.2.6",
    "jest": "^29.7.0",
    "node-fetch": "^2.6.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "workspaces": [
    "packages/shared",
    "packages/client",
    "packages/cli",
    "packages/blitz",
    "packages/redwood"
  ],
  "engines": {
    "node": ">=18.18"
  }
}
